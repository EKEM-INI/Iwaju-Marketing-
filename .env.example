# Google Gemini API Key — powers the Evidence Research Agent, the Buying-Signal
# Monitor and the /ask chatbox. Research and signals use Google Search grounding,
# so a claim without a retrieved URL is reported as unverified instead of written.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-3.8-flash, then gemini-flash-latest)
GEMINI_MODEL=

# (Optional) Google OAuth Client ID for custom brand consent
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend API Key to send 6-digit email verification codes to user inboxes (Get free key from https://resend.com)
RESEND_API_KEY=

# Apollo.io API Key (Get from Apollo -> Settings -> Integrations -> API Keys)
APOLLO_API_KEY=

# Google Maps / Places API Key (Optional: Google Cloud Console -> APIs & Services -> Places API)
GOOGLE_MAPS_API_KEY=

# OpenAI API Key used by the ChatGPT Brain (lead qualification, scoring, cold email copy, reports).
# Get an sk-... key from https://platform.openai.com/api-keys (a ChatGPT Plus login does NOT work here).
# The brain does not source leads; Apollo finds them, this key judges them.
# Without it, the Account Brief and Reply Intelligence agents fall back to rule-based readings
# and say so on screen — they never substitute invented copy.
CHAT_GPT_API=

# Optional: override the OpenAI model (defaults to gpt-4o-mini)
CHAT_GPT_MODEL=

# Optional: point the ChatGPT Brain at a different OpenAI-compatible endpoint (testing only).
# Defaults to https://api.openai.com/v1/chat/completions
# CHAT_GPT_BASE_URL=

# Agents that need no key at all: Contact Resolution (live DNS MX lookups), Data Hygiene,
# Account Fit scoring, Next-Best-Action and Forecast / Pipeline Risk run on rules and real checks.
